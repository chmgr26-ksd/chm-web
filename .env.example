# CHM Web 환경 변수 예시 — 실제 값은 .env.local(로컬) 또는 Hostinger 환경변수에 설정
# Phase 0에서는 아무것도 필요 없습니다. 아래는 Phase 2 이후 사용.

# --- Phase 2: 인증(Auth.js) ---
# NEXTAUTH_URL=https://your-domain
# NEXTAUTH_SECRET=  # openssl rand -base64 32 로 생성

# --- Phase 2: 데이터베이스(MySQL + Prisma) ---
# DATABASE_URL="mysql://user:pass@host:3306/dbname"

# --- Phase 4: 결제(예: 토스페이먼츠 / PortOne) ---
# PAYMENTS_CLIENT_KEY=
# PAYMENTS_SECRET_KEY=

# --- Hostinger 빌드 (devDependencies 설치 보장) ---
# NPM_CONFIG_PRODUCTION=false
