# CHM Web 환경 변수 예시 — 실제 값은 .env(로컬) 또는 Hostinger 환경변수에 설정.
# .env / .env.local 은 커밋되지 않습니다(.gitignore).

# --- 데이터베이스 (MySQL + Prisma) [필수] ---
DATABASE_URL="mysql://user:pass@host:3306/dbname"

# --- 인증 (Auth.js v5) [필수] ---
# AUTH_SECRET: openssl rand -base64 32 로 생성한 값
AUTH_SECRET="여기에_openssl_rand_결과"
# 리버스 프록시(Hostinger) 뒤에서 호스트 신뢰
AUTH_TRUST_HOST=true

# --- 초기 관리자 시드 (npx prisma db seed 실행 시에만 사용) ---
# ADMIN_EMAIL="admin@chm.kr"
# ADMIN_PASSWORD="8자이상_강한비밀번호"
# ADMIN_NAME="김수동"

# --- 이메일 알림(문의 접수 시) — 선택. 미설정 시 발송만 건너뜀 ---
# SMTP_HOST="smtp.hostinger.com"     # 예: Hostinger 이메일 SMTP
# SMTP_PORT="465"                    # 465(SSL) 또는 587(STARTTLS)
# SMTP_USER="noreply@yourdomain.kr"
# SMTP_PASS="메일계정_비밀번호"
# SMTP_FROM="CHM Group <noreply@yourdomain.kr>"   # 선택(기본 SMTP_USER)
# NOTIFY_EMAIL="admin@yourdomain.kr"  # 알림 수신(미설정 시 관리자 전체에게)

# --- Hostinger 빌드 (devDependencies 설치 보장) ---
NPM_CONFIG_PRODUCTION=false

# --- 후속(후원 결제): PG 연동 시 추가 (예: 토스페이먼츠 / PortOne) ---
# PAYMENTS_CLIENT_KEY=
# PAYMENTS_SECRET_KEY=
