// CHM Group 웹앱 — Prisma 스키마 (Phase 2: 회원·권한·문의·후원)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 권한 구분: 일반 회원 / 직원 / 관리자
enum Role {
  USER
  STAFF
  ADMIN
}

// 참여 신청 유형 (참여신청 폼)
enum InquiryType {
  REPAIR // 집수리 서비스
  EDU    // 집수리 교실 참가
  VOL    // 자원봉사 · 협력
}

// 문의 처리 상태
enum InquiryStatus {
  NEW       // 접수
  CONTACTED // 확인 연락 완료
  SCHEDULED // 방문/일정 조율
  DONE      // 완료
  CANCELED  // 취소
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  handledInquiries Inquiry[] @relation("InquiryHandler")
  inquiries        Inquiry[] @relation("InquiryOwner")
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  name      String
  phone     String
  area      String?
  message   String?       @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  handlerId String?
  handler   User?  @relation("InquiryHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  // 로그인 상태로 신청한 경우 본인(마이페이지에서 조회)
  userId String?
  user   User?  @relation("InquiryOwner", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

// 소식·게시판 카테고리
enum PostCategory {
  NOTICE   // 공지
  RECRUIT  // 모집
  EVENT    // 행사
  CAMPAIGN // 캠페인
}

// 소식·공지 게시글(관리자 직접 작성)
model Post {
  id         String       @id @default(cuid())
  category   PostCategory @default(NOTICE)
  title      String
  body       String       @db.Text
  published  Boolean      @default(true)
  authorId   String?
  authorName String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([published, createdAt])
  @@index([createdAt])
}

// 방문자 페이지뷰(공개 사이트) — 통계용.
model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

// 갤러리 이미지 — 바이너리를 DB(LONGBLOB)에 저장(배포에도 보존). 업로드 크기 제한.
model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 자주 묻는 질문(FAQ)
model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// 앱 설정(싱글턴) — 이메일 알림 발신/수신 구성. SMTP 비번은 암호화 저장(smtpPassEnc).
model AppSetting {
  id             String   @id @default("singleton")
  mailEnabled    Boolean  @default(false)
  mailRecipients String?  @db.Text // 콤마 구분 수신 이메일(비우면 관리자 전체)
  smtpHost       String?
  smtpPort       Int?     @default(587)
  smtpUser       String?
  smtpPassEnc    String?  @db.Text // AES-256-GCM 암호문(base64)
  smtpFrom       String?
  updatedAt      DateTime @updatedAt
}

// RBAC 감사 로그 — 회원 권한 변경 이력(누가·누구를·무엇으로).
// 사용자 삭제 후에도 이력이 남도록 이메일을 비정규화 저장.
model RoleChangeLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String
  targetId    String?
  targetEmail String
  fromRole    Role
  toRole      Role
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}

// 후원 (Phase 2 후속 — PG 연동 전 스캐폴드)
model Donation {
  id        String   @id @default(cuid())
  name      String
  amount    Int
  message   String?  @db.Text
  status    String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}
