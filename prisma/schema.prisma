// CHM Group 웹앱 — Prisma 스키마 (Phase 2: 회원·권한·문의·후원)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 권한 구분: 일반 회원 / 직원 / 관리자
enum Role {
  USER
  STAFF
  ADMIN
}

// 참여 신청 유형 (참여신청 폼)
enum InquiryType {
  REPAIR // 집수리 서비스
  EDU    // 집수리 교실 참가
  VOL    // 자원봉사 · 협력
}

// 문의 처리 상태
enum InquiryStatus {
  NEW       // 접수
  CONTACTED // 확인 연락 완료
  SCHEDULED // 방문/일정 조율
  DONE      // 완료
  CANCELED  // 취소
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  avatar          Bytes?    // 프로필 사진(정사각형 JPEG, 클라이언트 리사이즈). 없으면 이니셜 표시.
  avatarUpdatedAt DateTime? // 사진 변경 시각 — 세션 image URL 캐시버스트용.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  handledInquiries Inquiry[] @relation("InquiryHandler")
  inquiries        Inquiry[] @relation("InquiryOwner")
  passwordResets   PasswordResetToken[]
}

// 비밀번호 재설정 토큰 — 원본은 메일로만 보내고 DB엔 sha256 해시만 저장. 1시간 만료·1회용.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256(원본 토큰)
  expiresAt DateTime
  usedAt    DateTime? // 사용(소비)되면 기록 → 재사용 차단
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  name      String
  phone     String
  area      String?
  message   String?       @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  handlerId String?
  handler   User?  @relation("InquiryHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  // 로그인 상태로 신청한 경우 본인(마이페이지에서 조회)
  userId String?
  user   User?  @relation("InquiryOwner", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

// 소식·게시판 카테고리
enum PostCategory {
  NOTICE   // 공지
  RECRUIT  // 모집
  EVENT    // 행사
  CAMPAIGN // 캠페인
}

// 소식·공지 게시글(관리자 직접 작성)
model Post {
  id         String       @id @default(cuid())
  category   PostCategory @default(NOTICE)
  title      String
  body       String       @db.Text
  published  Boolean      @default(true)
  authorId   String?
  authorName String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([published, createdAt])
  @@index([createdAt])
}

// 방문자 페이지뷰(공개 사이트) — 통계용.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?  // 외부 유입 도메인(내부/직접 방문은 null)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([referrer])
}

// 갤러리 이미지 — 바이너리를 DB(LONGBLOB)에 저장(배포에도 보존). 업로드 크기 제한.
model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  mimeType  String
  size      Int
  data      Bytes
  thumb     Bytes?   // 그리드용 썸네일(JPEG, 업로드 시 클라이언트에서 생성). 없으면 원본 폴백.
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 이벤트·행사 — 일시·장소가 있는 행사 안내(소식과 별개, 예정/지난 행사 구분).
model Event {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  location    String?
  startAt     DateTime  // 행사 시작 일시
  endAt       DateTime? // 종료 일시(선택)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, startAt])
  @@index([startAt])
}

// 자주 묻는 질문(FAQ)
model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// 앱 설정(싱글턴) — 이메일 알림 발신/수신 구성. SMTP 비번은 암호화 저장(smtpPassEnc).
model AppSetting {
  id             String   @id @default("singleton")
  mailEnabled    Boolean  @default(false)
  mailRecipients String?  @db.Text // 콤마 구분 수신 이메일(비우면 관리자 전체)
  smtpHost       String?
  smtpPort       Int?     @default(587)
  smtpUser       String?
  smtpPassEnc    String?  @db.Text // AES-256-GCM 암호문(base64)
  smtpFrom       String?
  // 공개 사이트 연락처/기관 정보 — 비우면 constants.js 기본값으로 폴백.
  // 주소(contactAddress) 변경 시 오시는 길 지도(구글맵)에도 반영됨.
  contactPhone         String?
  contactEmail         String?
  contactAddress       String? // 지도·짧은 표기용(예: 대전광역시 유성구 어은동)
  contactAddressDetail String? @db.Text // 상세 주소 표기
  contactHours         String? @db.Text
  contactRep           String?
  companyKo            String?
  companyEn            String?
  // 랜딩 공지 배너(NoticeHero) 설정 — 비우면 lib/noticeHero.js 기본값으로 폴백.
  noticeHeroInterval Int?     // 배너 전환 간격(초, 3~10)
  noticeRollInterval Int?     // 공지 롤러 이동 간격(초, 2~6)
  noticeGradient     String?  // 그라디언트 톤 프리셋 key(amber|sunset|gold|brand)
  noticeExcerptLen   Int?     // 배너 설명 발췌 길이(자, 40~160)
  noticeAutoplay     Boolean? // 자동 전환/롤링
  noticeShowRoller   Boolean? // 우측 공지 롤러 표시
  updatedAt      DateTime @updatedAt
}

// 관리자가 교체 가능한 사이트 이미지 — key별 blob. 없으면 public/ 기본 파일로 폴백.
// key: about-team | business-field | landing-hero | main-field
model SiteImage {
  key       String   @id
  mimeType  String
  size      Int
  data      Bytes
  updatedAt DateTime @updatedAt
}

// RBAC 감사 로그 — 회원 권한 변경 이력(누가·누구를·무엇으로).
// 사용자 삭제 후에도 이력이 남도록 이메일을 비정규화 저장.
model RoleChangeLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String
  targetId    String?
  targetEmail String
  fromRole    Role
  toRole      Role
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}

// 후원 (Phase 2 후속 — PG 연동 전 스캐폴드)
model Donation {
  id        String   @id @default(cuid())
  name      String
  amount    Int
  message   String?  @db.Text
  status    String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// 후기 유형: 집수리 교실 후기(사진 롤링 + 내용) / 집수리 체험 후기(Before·After + 설명)
enum ReviewType {
  CLASS      // 집수리 교실 후기
  EXPERIENCE // 집수리 체험 후기
}

// 후기 이미지 역할: 교실 후기 롤링 사진 / 체험 후기 전·후
enum ReviewImageRole {
  PHOTO  // 교실 후기 롤링 사진(1~6장)
  BEFORE // 체험 전
  AFTER  // 체험 후
}

// 후기 — 관리자가 등록. 유형에 따라 표현 방식이 다르다(교실: 사진 롤링, 체험: Before/After).
model Review {
  id         String        @id @default(cuid())
  type       ReviewType
  title      String
  body       String        @db.Text
  authorName String?       // 참가자/작성자 이름(선택)
  published  Boolean       @default(true)
  images     ReviewImage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([type, published, createdAt])
}

// 후기 이미지 — 바이너리를 DB에 저장(갤러리와 동일 방식). 후기 삭제 시 함께 삭제.
model ReviewImage {
  id        String          @id @default(cuid())
  reviewId  String
  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  role      ReviewImageRole @default(PHOTO)
  sortOrder Int             @default(0) // 교실 후기 롤링 순서
  mimeType  String
  size      Int
  data      Bytes
  thumb     Bytes?          // 관리 목록용 썸네일
  createdAt DateTime        @default(now())

  @@index([reviewId, sortOrder])
}

// 자료실 문서 — 서식·간행물 등 다운로드 파일(PDF/HWP(X)/Office). 바이너리를 DB에 저장.
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  filename    String   // 원본 파일명(다운로드 시 사용)
  ext         String   // 소문자 확장자(pdf, docx, hwpx …) — 아이콘/표기용
  mimeType    String
  size        Int
  data        Bytes
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}
